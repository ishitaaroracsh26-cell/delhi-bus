# ==============================================================================
# DilliTransit - Environment Configuration
# ==============================================================================

# 1. Delhi Open Transit Data (OTD) Official Credentials
# How to obtain:
#   a) Register at https://otd.delhi.gov.in/ (Govt. of NCT of Delhi / IIIT-Delhi)
#   b) Navigate to "Real Time Data" section and request an API key.
#   c) Paste your allotted key below. Leave empty to use calibrated physics sample mode.
DELHI_OTD_API_KEY=

# 2. Server Configuration
PORT=8000
HOST=127.0.0.1

# 3. Telemetry Operating Mode
# Options:
#   auto   - Detects DELHI_OTD_API_KEY, verifies connection, falls back to calibrated physics mode
#   live   - Strict mode: requires active authenticated connection to otd.delhi.gov.in
#   sample - Calibrated physics simulation & authentic DTC/DIMTS route topology
DATA_SOURCE_MODE=auto

# 4. Initial Traffic Simulation Scenario
# Options: normal, peak_rush, bottleneck, off_peak
SIMULATION_SCENARIO=normal
